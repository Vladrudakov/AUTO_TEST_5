# If the SDK is not in the default Android Studio location, set its actual path here.
# Example: ANDROID_HOME=C:\Users\your-name\AppData\Local\Android\Sdk
ANDROID_HOME=
ANDROID_SDK_ROOT=

# Set this to the exact AVD name from Android Studio > Device Manager to let Appium launch it.
# Example: ANDROID_AVD=Pixel_5_API_34
ANDROID_AVD=
